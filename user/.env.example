# Demais variáveis: veja a seção "Variáveis de ambiente" do README.

# Chave pública ES256 do token interno, em base64 (uma linha).
# Gere com ./scripts/generate-internal-keys.sh (na raiz) e use apenas a linha da chave pública.
# A chave privada fica SOMENTE no .env do auth.
INTERNAL_JWT_PUBLIC_KEY_B64=
