APP_NAME=auth
PORTA=3001
USER_SERVER=localhost:3000
REDIS_HOST=localhost
REDIS_PORT=6379
NODE_ENV=dev

# Segredo HS256 do JWT entregue ao cliente no login. Use um valor forte e aleatório.
CHAVE_PRIVADA=
TEMPO_EXP=1d

# Chave privada ES256 do token interno, em base64 (uma linha).
# Gere com ./scripts/generate-internal-keys.sh (na raiz) e use apenas a linha da chave privada.
INTERNAL_JWT_PRIVATE_KEY_B64=

# Segredo compartilhado com o gateway (mínimo de 32 caracteres), o mesmo valor nos dois .env.
# Protege POST /internal/validate, a rota que emite o token interno. Gere com: openssl rand -base64 32
GATEWAY_SHARED_SECRET=
