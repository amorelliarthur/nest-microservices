PORT=3006
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
FINANCIAL_SERVER=http://localhost:3004
FINANCIAL_TIMEOUT_MS=3000
DATABASE_URL=postgres://admin:admin@localhost:5432/ai
TEST_DATABASE_URL=postgres://admin:admin@localhost:5432/ai_test
KNOWLEDGE_MAX_DISTANCE=0.35

# ES256 public key of the internal token, base64 (one line).
# Generate it with ./scripts/generate-internal-keys.sh (repo root) and use only the public key line.
# The private key stays ONLY in the auth service .env.
INTERNAL_JWT_PUBLIC_KEY_B64=
